# FOR POSTGRES (USED IN TESTS ONLY)
TEST_PG_HOST=localhost
TEST_PG_DATABASE=test_workflow
TEST_PG_USER=
TEST_PG_PASSWORD=
TEST_PG_PORT=5432

# FOR POSTGRES (USED BY THE INTERACTIVE EXAMPLE ONLY — see example/README.md)
# Point this at a database of its own: `deno task example` migrates it on boot and
# creates the workflow, steve and cron tables in it.
EXAMPLE_PG_HOST=localhost
EXAMPLE_PG_DATABASE=example_workflow
EXAMPLE_PG_USER=
EXAMPLE_PG_PASSWORD=
EXAMPLE_PG_PORT=5432

# Optional. The example server binds 127.0.0.1 on port 8000 unless told otherwise.
# PORT=8000
# EXAMPLE_HOST=0.0.0.0
